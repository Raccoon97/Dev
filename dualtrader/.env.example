# ──────────────────────────────────────────────
# DualTrader 환경변수 설정
# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.
# cp .env.example .env
# ──────────────────────────────────────────────

# 초기 예수금 (원)
INITIAL_CAPITAL_KRW=10000000

# ──────────────────────────────────────────────
# 한국투자증권 OpenAPI (KIS Developers)
# https://apiportal.koreainvestment.com/
# ──────────────────────────────────────────────
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_ACCOUNT_NO=12345678-01
KIS_ACCOUNT_PRODUCT=01
# 모의투자: https://openapivts.koreainvestment.com:29443
# 실거래:   https://openapi.koreainvestment.com:9443
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_IS_PAPER=true

# ──────────────────────────────────────────────
# Alpaca Markets API
# https://alpaca.markets/
# ──────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
# 페이퍼: https://paper-api.alpaca.markets
# 실거래: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_IS_PAPER=true

# ──────────────────────────────────────────────
# 텔레그램 봇
# https://core.telegram.org/bots#6-botfather
# ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
